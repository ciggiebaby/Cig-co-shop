# Payment providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook ID shown in your PayPal app after adding the paypal-webhook URL
PAYPAL_WEBHOOK_ID=
COINBASE_COMMERCE_API_KEY=
# Shared secret from Coinbase Commerce > Settings > Notifications
COINBASE_COMMERCE_WEBHOOK_SECRET=

# Printful print-on-demand (server-side only)
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
# Leave false: orders arrive in Printful as drafts you review and confirm.
# Set to true only when you want paid orders sent to print (and billed) automatically.
PRINTFUL_AUTO_CONFIRM=false
# Signing secret of the separate Stripe webhook pointing at /.netlify/functions/printful-fulfillment
STRIPE_PRINTFUL_WEBHOOK_SECRET=

# Site
SITE_URL=https://cigcompany.com

# Unified customer database (server-side only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Kit marketing list (server-side only)
KIT_API_KEY=
KIT_ARCADE_TAG_ID=
KIT_CHECKOUT_TAG_ID=
KIT_CUSTOMER_TAG_ID=
KIT_FIRST_ORDER_TAG_ID=
KIT_REPEAT_CUSTOMER_TAG_ID=
KIT_MARKETING_OPT_IN_TAG_ID=

# Resend transactional email (server-side only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=CIG & CO. <info@cigcompany.com>

# Internal CSV/shipment endpoints (server-side only)
ADMIN_EXPORT_TOKEN=
